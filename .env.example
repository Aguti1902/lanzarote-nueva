# Admin panel (obligatorio en producción / Vercel)
# Nunca uses la contraseña por defecto. Cambia ADMIN_PASSWORD en Vercel.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión (recomendado; si falta se usa ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# Secreto del cron de backups diarios (Vercel Cron → Bearer CRON_SECRET)
CRON_SECRET=

# Supabase (requerido en producción / Vercel)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo servidor (API routes, seed). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: si añades una clave de OpenAI, el chat usará IA real.
# Sin ella, responde con el asistente local basado en el contenido de la web.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (pagos online)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional (Checkout hospedado no la requiere; Elements sí)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# También aceptable en Vercel si NEXT_PUBLIC_… da problemas: no usada por el código
# PUBLI_STRIPE_KEY=
NEXT_PUBLIC_SITE_URL=

# Emails (Resend) — operativos + cliente
# Remitente automático según tipo:
#   excursiones/traslados → booking@lanzaroteexperiencetours.com
#   cruceros → cruise@lanzaroteexperiencetours.com
#   contacto → support@… | bajo petición → info@…
RESEND_API_KEY=
# Opcional: solo fallback si algún envío no indica remitente
# MAIL_FROM=Lanzarote Experience Tours <booking@lanzaroteexperiencetours.com>
