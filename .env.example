# Admin panel
ADMIN_PASSWORD=

# Supabase (requerido en producción / Vercel)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: solo servidor (API routes, seed). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: si añades una clave de OpenAI, el chat usará IA real.
# Sin ella, responde con el asistente local basado en el contenido de la web.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (pagos online)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional (Checkout hospedado no la requiere; Elements sí)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# También aceptable en Vercel si NEXT_PUBLIC_… da problemas: no usada por el código
# PUBLI_STRIPE_KEY=
NEXT_PUBLIC_SITE_URL=

# Emails (Resend) — notificaciones operativas
# Bajo petición → info@… | Reservas/traslados → booking@… |
# Contacto → support@… | Cruceristas → cruise@…
RESEND_API_KEY=
# Opcional cuando el dominio esté verificado en Resend:
# MAIL_FROM=Lanzarote Experience Tours <booking@lanzaroteexperiencetours.com>
